# Скопируйте в .env и заполните. .env в git не попадает.

# --- Telegram ---
BOT_TOKEN=                 # основной бот (в группе: админ, /setprivacy → Disable, Bot-to-Bot mode → On)
ACTOR_BOT_TOKENS=          # боты-участники для живых тестов, через запятую
TEST_CHAT_ID=              # id тестовой группы (бот покажет по /chatid)
ALLOW_ACTOR_BOTS=true      # принимать сообщения ботов-участников (только тестовый чат)

# --- GigaChat ---
GIGACHAT_AUTH_KEY=         # ключ авторизации из developers.sber.ru (base64 client_id:secret)
GIGACHAT_SCOPE=GIGACHAT_API_PERS
EXTRACT_PROMPT=v2
GIGACHAT_MODEL=GigaChat-2

# --- Инфраструктура ---
POSTGRES_USER=dogovorilis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dogovorilis
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://dogovorilis:change-me@localhost:5433/dogovorilis
REDIS_URL=redis://localhost:6380/0

# --- Веб-доска ---
BOARD_SECRET=change-me
BOARD_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8010
DEADLINE_ASK_DELAY_S=0  # через сколько секунд спросить срок, если задачу взяли без срока (0 — сразу)

# личный тариф GigaChat: 1 одновременный запрос на аккаунт
GIGACHAT_CONCURRENCY=1
# деградация: при очереди ≥ N откладываем слабые сигналы, при ≥ M — быстрая модель
DEGRADE_STRICT_AT=10
DEGRADE_FAST_AT=40
DEGRADE_MODEL=GigaChat-2
